# Puerto del servidor
PORT=5000

# MongoDB (Atlas)
MONGODB_URI=mongodb+srv://USUARIO:CONTRASENA@cluster.mongodb.net/?appName=PagaYA-Dev

# JWT
JWT_SECRET=reemplazar_por_secreto_seguro
JWT_EXPIRES_IN=8h

# Recuperación de contraseña y correo SMTP
FRONTEND_URL=http://localhost:5173
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=reemplazar_por_usuario_smtp
SMTP_PASSWORD=reemplazar_por_password_smtp
MAIL_FROM=PagaYA <no-reply@example.com>

# SQL Server - Habilitar conexión (true por defecto; false = omitir SQL por completo, sin intentar conectar)
SQL_ENABLED=false

# SQL Server - Base principal
SQL_SERVER=localhost
SQL_PORT=1433
SQL_DATABASE=PagaYA_SQL
SQL_USER=PagaYA
SQL_PASSWORD=reemplazar_por_contrasena
SQL_ENCRYPT=false
SQL_TRUST_SERVER_CERTIFICATE=true

# SQL Server - Base de respaldo
SQL_BACKUP_DATABASE=PagaYA_Backup
